[
  {
    "id": "41616917738a2a8d7ab8c0f7780218c588c3519c",
    "text": "「この社長、たぶんゲーム好きだな…」なぜそう思った？",
    "genre": "仕事"
  },
  {
    "id": "4dd69285e903116f9bdff7cbbf96bb0c5150f690",
    "text": "「このキャラ、たぶん作者の推しだろうな…」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "507d8524be87dd6bb76c8ade171e1150cf295f07",
    "text": "サッカー選手の本音を教えてください",
    "genre": "スポーツ"
  },
  {
    "id": "5c43f1982f78765d0e8554d89014fb45c8c23747",
    "text": "「この番組、打ち切りになりそう…」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "21b4df1599d39023ee9075ffbe47744aedcddc61",
    "text": "こんな卓球大会は嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "bba680f8ccc72be49a2dfbaf1a9dcc752ae6e860",
    "text": "バスケットボール選手の口ぐせを教えてください",
    "genre": "スポーツ"
  },
  {
    "id": "1b0598073aa914136745a9de3d68beff62b6ff33",
    "text": "カメラマンがシャッターを押した瞬間、内心考えていそうなことは？",
    "genre": "メタ"
  },
  {
    "id": "7c82ec8b5805dd277ef0a47ffb5ba51678222b0b",
    "text": "カンガルーの悩みを教えてください",
    "genre": "動物"
  },
  {
    "id": "e6ed9ca7b2c0f2ecbfa3bed783ad543d37b0cbe7",
    "text": "すぐキレる調理師、どんなの？",
    "genre": "仕事"
  },
  {
    "id": "ecaa04ce654f1fde213b740569e42f1d34db1e3c",
    "text": "時間にルーズな配達員、どんなの？",
    "genre": "日常"
  },
  {
    "id": "8f3bfa1c9528baa6f126eaeda578ac61fb37cba4",
    "text": "こんなパソコンは嫌だ",
    "genre": "テック"
  },
  {
    "id": "a229edadc55b591529e9444969c9e1bc5c9ab8c2",
    "text": "亀が急にスピードを出し始めた理由は？",
    "genre": "動物"
  },
  {
    "id": "3e4d3c4bcf67fc0cb1420a1febaaed56dc1945ce",
    "text": "「この風邪薬、たぶん気休めだろ…」なぜそう思った？",
    "genre": "季節"
  },
  {
    "id": "6816920ad8acae2f7d9050e58bfbb6bf4d458401",
    "text": "こんな公園は嫌だ",
    "genre": "日常"
  },
  {
    "id": "9eb22015020eb5d9363acc8c8d6801102326db55",
    "text": "こんなペットショップは嫌だ",
    "genre": "動物"
  },
  {
    "id": "012e6391619a94423255e7d5a3bc08a306e544c6",
    "text": "雪がピンクの世界、何が起こる？",
    "genre": "季節"
  },
  {
    "id": "09a864f9ad00bb46f7277db375ad8b293b3d9119",
    "text": "優柔不断なパイロット、どんなの？",
    "genre": "家族"
  },
  {
    "id": "9891c85944354b91d1103224f60926668108a887",
    "text": "ハリネズミの口ぐせを教えてください",
    "genre": "動物"
  },
  {
    "id": "37ea068ec9507df6656e70dd577a0c2e64722d8f",
    "text": "ネコカフェの店員の悩みを教えてください",
    "genre": "メタ"
  },
  {
    "id": "8870236f47e5d811f710826dcd44528d5d34c268",
    "text": "絶対にモテない香水の名前は？",
    "genre": "日常"
  },
  {
    "id": "71dd069b81d2a486fa902e4045243d2609024616",
    "text": "結婚式で花嫁が急に走り出した理由は？",
    "genre": "恋愛"
  },
  {
    "id": "cc77d566f25e524f86012caa0062a8c4859d73af",
    "text": "サーファーの口ぐせを教えてください",
    "genre": "スポーツ"
  },
  {
    "id": "1771f2f3a50876055862c771a500f8e10fe8c089",
    "text": "コアラが内心考えていそうなことは？",
    "genre": "動物"
  },
  {
    "id": "1875255822f8942ce62a084aafc38af5413636ad",
    "text": "「この家族、ドラマみたいだ」なぜそう思った？",
    "genre": "家族"
  },
  {
    "id": "a56f43b1281ffad5807ae5713478c28e5260eee1",
    "text": "抜けが多い警官、どんなの？",
    "genre": "日常"
  },
  {
    "id": "fcb1e16bf6b5515014b5796037fef1c4bcf5ac13",
    "text": "花見が急に中止になった理由は？",
    "genre": "季節"
  },
  {
    "id": "1673df8bbaaffafe876da802d1185eea900298df",
    "text": "野球の監督の本音を教えてください",
    "genre": "スポーツ"
  },
  {
    "id": "513a2960a45f7baea7d69aa8751a89886f467af1",
    "text": "こんなラジオ番組は嫌だ",
    "genre": "メタ"
  },
  {
    "id": "a2e9e399346bc84eef56ce5e59900b7279f86fc7",
    "text": "無責任な秘書、どんなの？",
    "genre": "仕事"
  },
  {
    "id": "a34f5dd73813117013e6894672f67138accef61d",
    "text": "こんなデートは嫌だ",
    "genre": "恋愛"
  },
  {
    "id": "94d064df1f215f87afce8b80b8bd58563e4d7d4d",
    "text": "赤ちゃんの悩みを教えてください",
    "genre": "家族"
  },
  {
    "id": "2159946eae94585ccb31b78e9367d687ad30b72b",
    "text": "演劇部の部員が急に消えた理由は？",
    "genre": "メタ"
  },
  {
    "id": "db89f9be25156661d87c4a3fffb732359995eb72",
    "text": "ゴリラが内心考えていそうなことは？",
    "genre": "動物"
  },
  {
    "id": "93939f848d1dd42d718a135780189c904afe9bcf",
    "text": "こんなフィギュアスケートは嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "8730b29509b177d2d6fc88d4261ad6d043276626",
    "text": "「この兄弟、絶対仲が悪いな」なぜそう思った？",
    "genre": "家族"
  },
  {
    "id": "d661968d9241126934070d107114d9cc8a73c467",
    "text": "「この歴史書、たぶんフィクションだろ…」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "d2b3c12ef6145362c061be85294ee30076988257",
    "text": "「この子供、将来大物になるかも」なぜそう思った？",
    "genre": "家族"
  },
  {
    "id": "1a1f488faa0ff0ed1ba56a75a7efd3c876b4c162",
    "text": "こんなニュース番組は嫌だ",
    "genre": "メタ"
  },
  {
    "id": "4147e5993649bbc7f77625cc483f6c0020bf3b1c",
    "text": "もしも冷蔵庫が話せたら、どんなことを言う？",
    "genre": "テック"
  },
  {
    "id": "05f8832290a631353f13ddea0a58d2d06ad919b8",
    "text": "ゴルフのホールインワン直後、内心考えていそうなことは？",
    "genre": "スポーツ"
  },
  {
    "id": "4a3ff3068e5c40c187851a8d835259bac436e93b",
    "text": "こんなテニスコートは嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "4b33296859e423f655ef17b3895d1f148acead53",
    "text": "スキー場が真夏に大混雑している理由は？",
    "genre": "家族"
  },
  {
    "id": "f47d702ed42ec17853ece7394556235605d14dc5",
    "text": "サンタクロースの悩みを教えてください",
    "genre": "季節"
  },
  {
    "id": "ec7ceb002077e527388210e18dd3ff8ca4b294b5",
    "text": "家族が急にキャンプを始めた理由は？",
    "genre": "家族"
  },
  {
    "id": "7162ee73f0ea45421261a12902bda1bd0fcc7cc3",
    "text": "「このスポーツ選手、絶対に寝不足だろ…」なぜそう思った？",
    "genre": "スポーツ"
  },
  {
    "id": "18361d18762fec7cb22a0e52ed47907e2366f5e7",
    "text": "ヒーローを目指すサークルの活動内容",
    "genre": "恋愛"
  },
  {
    "id": "0f20871723d87bfe7b8dc5f919140e13ba5c659e",
    "text": "「この絵、本物じゃないな」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "0968fc5d81e1473100d64edaa704fb441b5b2d2e",
    "text": "社長が急に踊り出した理由は？",
    "genre": "仕事"
  },
  {
    "id": "bb037bec6615ed392caeb65004605c3213bba39a",
    "text": "明るすぎる雪女、どんなの？",
    "genre": "季節"
  },
  {
    "id": "f9933315dca8cd276ee94cfa48c167a979f3a54d",
    "text": "こんな卒業式は嫌だ",
    "genre": "学校"
  },
  {
    "id": "d8de372617a34c9d2b755bc7938178605b7491da",
    "text": "こんな学校の遠足は嫌だ",
    "genre": "学校"
  },
  {
    "id": "03e84b648fff5fb5f82e1b40824083bc7f7d57ef",
    "text": "クリスマスの前後だけ忙しい探偵のスケジュール",
    "genre": "季節"
  },
  {
    "id": "6dc6a45d8fb1f5c127393da5594f71ba5120f9bb",
    "text": "反省しないコーチ、どんなの？",
    "genre": "スポーツ"
  },
  {
    "id": "074ccdad74585e8b0f43241269d186ba6ad49219",
    "text": "柔道家の悩みを教えてください",
    "genre": "スポーツ"
  },
  {
    "id": "7075e9eb1fe1890e4c0e205b5a51916cd7a18607",
    "text": "「この花火、去年の余りだな…」なぜそう思った？",
    "genre": "季節"
  },
  {
    "id": "7e65e97e22e4044bae0b0771e7255b2591bd13bd",
    "text": "「この審判、たぶん寝てたな」なぜそう思った？",
    "genre": "スポーツ"
  },
  {
    "id": "6e2f83ecdebf83dd61473cf4807e61adfde1c305",
    "text": "こんな弁護士は嫌だ",
    "genre": "仕事"
  },
  {
    "id": "47736561d00546a6c78a925aabb6c1dfbe26fff7",
    "text": "おっちょこちょいな郵便配達員、どんなの？",
    "genre": "日常"
  },
  {
    "id": "ac731b691b163cfcf109522897378820baf52998",
    "text": "「このラブソング、何かおかしい…」なぜそう思った？",
    "genre": "恋愛"
  },
  {
    "id": "b71c885843d6c541e88ad0f2a2939cda1e53886c",
    "text": "細かすぎる映画監督、どんなの？",
    "genre": "メタ"
  },
  {
    "id": "b33ccd5e462ce8bf5a92dc86b14bcdd2a3952f73",
    "text": "正直すぎるサッカー審判、どんなの？",
    "genre": "スポーツ"
  },
  {
    "id": "dc36ef1bf417f7aa3365fc66672c812ec9b40978",
    "text": "こんな文化祭は嫌だ",
    "genre": "学校"
  },
  {
    "id": "6e8469ec65a1ff9f79c0e312d8cdd548593cf94c",
    "text": "こんな野球場は嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "edb6982456ea51b5915e0f8d1d2cab31238d227c",
    "text": "ミュージシャン専門の求人サイト",
    "genre": "仕事"
  },
  {
    "id": "81e338afe5aea15f646894ea637d7ce4d0ce9bc1",
    "text": "魔法使いの不満を教えてください",
    "genre": "家族"
  },
  {
    "id": "2eff714b469fca1fbad6bcbab6370ce8d82cac11",
    "text": "こんな学校行事は嫌だ",
    "genre": "学校"
  },
  {
    "id": "7564b258febdb877a2491270e935bec0cb902f4a",
    "text": "こんな会議室は嫌だ",
    "genre": "仕事"
  },
  {
    "id": "d4c36aea231e6323b4a3c49edb5dbc8223d9457b",
    "text": "こんな夏祭りは嫌だ",
    "genre": "季節"
  },
  {
    "id": "24c1e8178d625f1499cec734667e477730624195",
    "text": "お母さんの秘密を教えてください",
    "genre": "家族"
  },
  {
    "id": "448323aaa5f337d9fa5274122782ad3433b1cf4f",
    "text": "こんなジムは嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "c7302d140a97442965d910e3cfdd634990031feb",
    "text": "「このライオン、たぶん草食系だろ…」なぜそう思った？",
    "genre": "動物"
  },
  {
    "id": "7b58583db967fa9041193fc0900b56c3d730ae9f",
    "text": "臆病なワニ、どんなの？",
    "genre": "動物"
  },
  {
    "id": "5967584550a4729c4825668f10b3146a800e7871",
    "text": "冬休みが短くなった理由は？",
    "genre": "季節"
  },
  {
    "id": "302fcfe19cddce1f29bf26c14bb6cc650f14210b",
    "text": "情に薄いAI、どんなの？",
    "genre": "テック"
  },
  {
    "id": "2bdefbd154f063f62bacb889924de47898d4dd63",
    "text": "家族の決まり事を教えてください",
    "genre": "家族"
  },
  {
    "id": "746b182bee7da04ae5ed313d74858e63bd1f8363",
    "text": "デートで手を繋いだ瞬間、相手が内心考えていそうなことは？",
    "genre": "恋愛"
  },
  {
    "id": "ec48ece461be46e369637cea4d5aeac87336fd29",
    "text": "卓球のコーチが急に泣き出した理由は？",
    "genre": "スポーツ"
  },
  {
    "id": "83725325933c35a4c396406707075b3bbe3e95c7",
    "text": "アリクイがしょんぼりしている理由は？",
    "genre": "動物"
  },
  {
    "id": "d33d6e2d73eaf0c1769b1203538b07991af51ba2",
    "text": "ゴールを決めた瞬間、選手が内心考えていそうなことは？",
    "genre": "スポーツ"
  },
  {
    "id": "ab174a60f226522eedf4b5cf87f2adf4062bf23c",
    "text": "ちょっと過保護すぎる父親、どんなの？",
    "genre": "家族"
  },
  {
    "id": "e95b8b779afb8d057f59e3c6a3d96e3576e647b3",
    "text": "「この告白、きっと失敗するだろうな…」なぜそう思った？",
    "genre": "恋愛"
  },
  {
    "id": "2a70752022409a52aa1506da4f5e54df976cba94",
    "text": "「あのコーチ、絶対に試合を見てないな」なぜそう思った？",
    "genre": "スポーツ"
  },
  {
    "id": "9eaaa85c4474fcf2288c5872ee64fc7f0c4a19ca",
    "text": "こんな電子辞書は嫌だ",
    "genre": "テック"
  },
  {
    "id": "747a71d5131e70eddc5032b29b10930049a6a687",
    "text": "大工の休憩時間を教えてください",
    "genre": "仕事"
  },
  {
    "id": "a6510cfd093e5f7b82380ac5d1aa7dd5a75a51dc",
    "text": "「この掃除、絶対に終わらないだろう…」なぜそう思った？",
    "genre": "日常"
  },
  {
    "id": "5451bed407e3355f47724095db13658a6c52b009",
    "text": "気が短すぎるおじいちゃん、どんなの？",
    "genre": "家族"
  },
  {
    "id": "c446cec2bfc9cd5ed23e50d57a92a514fc4d3893",
    "text": "競技中に寝てもいいスポーツのルール",
    "genre": "スポーツ"
  },
  {
    "id": "046c4cfd768a7765da532def5228143828087de7",
    "text": "「この人、たぶん別れを考えてる…」なぜそう思った？",
    "genre": "恋愛"
  }
]
