[
  {
    "id": "2eff714b469fca1fbad6bcbab6370ce8d82cac11",
    "text": "こんな学校行事は嫌だ",
    "genre": "学校"
  },
  {
    "id": "7564b258febdb877a2491270e935bec0cb902f4a",
    "text": "こんな会議室は嫌だ",
    "genre": "仕事"
  },
  {
    "id": "d1f663d09d3d880ce74e8fdd15342571e50238b7",
    "text": "こんな兄弟は嫌だ",
    "genre": "家族"
  },
  {
    "id": "d4c36aea231e6323b4a3c49edb5dbc8223d9457b",
    "text": "こんな夏祭りは嫌だ",
    "genre": "季節"
  },
  {
    "id": "24c1e8178d625f1499cec734667e477730624195",
    "text": "お母さんの秘密を教えてください",
    "genre": "家族"
  },
  {
    "id": "448323aaa5f337d9fa5274122782ad3433b1cf4f",
    "text": "こんなジムは嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "c7302d140a97442965d910e3cfdd634990031feb",
    "text": "「このライオン、たぶん草食系だろ…」なぜそう思った？",
    "genre": "動物"
  },
  {
    "id": "a12651d3bcc0e9c73ff615f83ee06e2b32c89399",
    "text": "臆病なワニ、どんなワニ？",
    "genre": "動物"
  },
  {
    "id": "5967584550a4729c4825668f10b3146a800e7871",
    "text": "冬休みが短くなった理由は？",
    "genre": "季節"
  },
  {
    "id": "1f8549fe1069a6e90ffd6d7c8138fbaa10ab739b",
    "text": "最新スマートフォンの悩みを教えてください",
    "genre": "テック"
  },
  {
    "id": "28279cf3e259622aa164a47fb2ece68c2994ff8b",
    "text": "情に薄いAI、どんなAI？",
    "genre": "テック"
  },
  {
    "id": "2bdefbd154f063f62bacb889924de47898d4dd63",
    "text": "家族の決まり事を教えてください",
    "genre": "家族"
  },
  {
    "id": "746b182bee7da04ae5ed313d74858e63bd1f8363",
    "text": "デートで手を繋いだ瞬間、相手が内心考えていそうなことは？",
    "genre": "恋愛"
  },
  {
    "id": "ec48ece461be46e369637cea4d5aeac87336fd29",
    "text": "卓球のコーチが急に泣き出した理由は？",
    "genre": "スポーツ"
  },
  {
    "id": "83725325933c35a4c396406707075b3bbe3e95c7",
    "text": "アリクイがしょんぼりしている理由は？",
    "genre": "動物"
  },
  {
    "id": "d33d6e2d73eaf0c1769b1203538b07991af51ba2",
    "text": "ゴールを決めた瞬間、選手が内心考えていそうなことは？",
    "genre": "スポーツ"
  },
  {
    "id": "c4fd68e3c8e30dac6a5b49e2c8c852db6c26bc78",
    "text": "ちょっと過保護すぎる父親、どんな父親？",
    "genre": "家族"
  },
  {
    "id": "4a3ff3068e5c40c187851a8d835259bac436e93b",
    "text": "こんなテニスコートは嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "e95b8b779afb8d057f59e3c6a3d96e3576e647b3",
    "text": "「この告白、きっと失敗するだろうな…」なぜそう思った？",
    "genre": "恋愛"
  },
  {
    "id": "2a70752022409a52aa1506da4f5e54df976cba94",
    "text": "「あのコーチ、絶対に試合を見てないな」なぜそう思った？",
    "genre": "スポーツ"
  },
  {
    "id": "9eaaa85c4474fcf2288c5872ee64fc7f0c4a19ca",
    "text": "こんな電子辞書は嫌だ",
    "genre": "テック"
  },
  {
    "id": "747a71d5131e70eddc5032b29b10930049a6a687",
    "text": "大工の休憩時間を教えてください",
    "genre": "仕事"
  },
  {
    "id": "a6510cfd093e5f7b82380ac5d1aa7dd5a75a51dc",
    "text": "「この掃除、絶対に終わらないだろう…」なぜそう思った？",
    "genre": "日常"
  },
  {
    "id": "a1b17063ff34fc264bc49e9a231e2aedb17f07a8",
    "text": "気が短すぎるおじいちゃん、どんな人？",
    "genre": "家族"
  },
  {
    "id": "c446cec2bfc9cd5ed23e50d57a92a514fc4d3893",
    "text": "競技中に寝てもいいスポーツのルール",
    "genre": "スポーツ"
  },
  {
    "id": "046c4cfd768a7765da532def5228143828087de7",
    "text": "「この人、たぶん別れを考えてる…」なぜそう思った？",
    "genre": "恋愛"
  },
  {
    "id": "003683df8fd0e04ea799ae738a46a8be48e81544",
    "text": "こんな工事現場は嫌だ",
    "genre": "仕事"
  },
  {
    "id": "9fa5727370e1b358c1466ac90b6ce8e39b978bd5",
    "text": "「この冬、早く終わってほしい…」なぜそう思った？",
    "genre": "季節"
  }
]