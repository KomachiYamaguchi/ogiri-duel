[
  {
    "id": "4dd69285e903116f9bdff7cbbf96bb0c5150f690",
    "text": "「このキャラ、たぶん作者の推しだろうな…」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "7c82ec8b5805dd277ef0a47ffb5ba51678222b0b",
    "text": "カンガルーの悩みを教えてください",
    "genre": "動物"
  },
  {
    "id": "6816920ad8acae2f7d9050e58bfbb6bf4d458401",
    "text": "こんな公園は嫌だ",
    "genre": "日常"
  },
  {
    "id": "9eb22015020eb5d9363acc8c8d6801102326db55",
    "text": "こんなペットショップは嫌だ",
    "genre": "動物"
  },
  {
    "id": "d661968d9241126934070d107114d9cc8a73c467",
    "text": "「この歴史書、たぶんフィクションだろ…」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "d2b3c12ef6145362c061be85294ee30076988257",
    "text": "「この子供、将来大物になるかも」なぜそう思った？",
    "genre": "家族"
  },
  {
    "id": "1a1f488faa0ff0ed1ba56a75a7efd3c876b4c162",
    "text": "こんなニュース番組は嫌だ",
    "genre": "メタ"
  },
  {
    "id": "4a3ff3068e5c40c187851a8d835259bac436e93b",
    "text": "こんなテニスコートは嫌だ",
    "genre": "スポーツ"
  },
  {
    "id": "4b33296859e423f655ef17b3895d1f148acead53",
    "text": "スキー場が真夏に大混雑している理由は？",
    "genre": "家族"
  },
  {
    "id": "f47d702ed42ec17853ece7394556235605d14dc5",
    "text": "サンタクロースの悩みを教えてください",
    "genre": "季節"
  },
  {
    "id": "0f20871723d87bfe7b8dc5f919140e13ba5c659e",
    "text": "「この絵、本物じゃないな」なぜそう思った？",
    "genre": "メタ"
  },
  {
    "id": "e95b8b779afb8d057f59e3c6a3d96e3576e647b3",
    "text": "「この告白、きっと失敗するだろうな…」なぜそう思った？",
    "genre": "恋愛"
  },
  {
    "id": "c446cec2bfc9cd5ed23e50d57a92a514fc4d3893",
    "text": "競技中に寝てもいいスポーツのルール",
    "genre": "スポーツ"
  },
  {
    "id": "3e2e721b110fa4767182416cc219338a176e7a7a",
    "text": "リモートですることか！何？",
    "genre": "投稿"
  },
  {
    "id": "261b7466828bb65d40531e9823d656b7acc3cc01",
    "text": "忍者部の今日の練習内容を教えてください",
    "genre": "自作"
  },
  {
    "id": "110768fab31d7d76b2182c7dc80f86051469e59e",
    "text": "一発でいじめがなくなった行動とは",
    "genre": "自作"
  },
  {
    "id": "61fd09da0f1465be30e413d8936962a6d4fdac96",
    "text": "最悪な医者、どんなの？",
    "genre": "自作"
  },
  {
    "id": "c0d58f99bf8ab9714d64fd3b229ea4bc04f076d9",
    "text": "3本しか売れなかったゲームのタイトルは？",
    "genre": "自作"
  },
  {
    "id": "8b8935f5591cadedcd29aa30dc2b1621c3f3873a",
    "text": "100年の恋も一発で冷ますひとこと",
    "genre": "自作"
  },
  {
    "id": "6804ca4f7d3e18e93eccedf1378db3efb984a4c1",
    "text": "あざとくて何が悪いの？みたいなことを言ってください",
    "genre": "自作"
  },
  {
    "id": "58927d459de2e8a46d5e6569660ad4abf2cb9854",
    "text": "フランケンシュタインの悩みを教えてください",
    "genre": "自作"
  },
  {
    "id": "7274266046f69fa99eff618b4187832c2960d654",
    "text": "沖縄の生態系を崩してください",
    "genre": "自作"
  },
  {
    "id": "e2e5a391ed11472cedcdb3dd89674c7cdbb58bab",
    "text": "心臓を打たれた先輩刑事を3秒だけ生き返らせてください",
    "genre": "自作"
  },
  {
    "id": "cb3e338144dc75a32fefc09f7a2b9359f8bb4750",
    "text": "ガンジーの知られてない悪行とは？",
    "genre": "自作"
  },
  {
    "id": "6e863e46304aa4a751fa2a06f3c285b7da126532",
    "text": "緊急手術中に言うことか、何？",
    "genre": "自作"
  },
  {
    "id": "0921a93ad14152c348e6d08986b0b6479f8679ef",
    "text": "全国からツチノコが大集合、何があった？",
    "genre": "自作"
  },
  {
    "id": "e6a20709f7d6f4f802708ec9d1f4d270d948bb2d",
    "text": "ウミガメのスープを飲んで男は自殺した。なぜ？",
    "genre": "自作"
  },
  {
    "id": "c1a7ec1e736f76a1868764f19e433502a84b180e",
    "text": "校長先生の話を終わらせてください",
    "genre": "自作"
  },
  {
    "id": "3e8e78a6ff51e905830c8583b45948f210ec2113",
    "text": "大声で言うことか、何？",
    "genre": "自作"
  },
  {
    "id": "5ba7396ff783950adf82cad8d8729629b0ea645f",
    "text": "53秒、何の数字？",
    "genre": "自作"
  },
  {
    "id": "b2c58ffee82fa5e90abbf657313497101f6d51fa",
    "text": "三笘の1ミリ、みたいなことを言ってください。",
    "genre": "自作"
  },
  {
    "id": "8a0a4a7f9dfc7ea2ed90926608f91a1a95de29e4",
    "text": "「このバイト今日やめるな」なぜ？",
    "genre": "自作"
  },
  {
    "id": "b641d28d25c81732f9d8975ec9ad933a50bec930",
    "text": "難波スパイ学園の校則を教えてください",
    "genre": "自作"
  },
  {
    "id": "fbca1d348866d79ee0929b0bbb9c1bb23e3116e6",
    "text": "ドラえもんの知られてない秘密とは？",
    "genre": "自作"
  },
  {
    "id": "c1d57102c6edb41ddb2b2c11b291b220865be04f",
    "text": "タイムスリップして嫌だったことを教えてください",
    "genre": "自作"
  },
  {
    "id": "cf8c9ef4a4bae34feeb5234381fd5d5238e26c49",
    "text": "ムキムキ遊園地のアトラクションとは？",
    "genre": "自作"
  }
]
